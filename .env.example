# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Optional fallback provider for free open-source LLMs (Llama 3.3, Mistral, Qwen, DeepSeek)
# Used as a reciprocal backup to prevent Gemini API quota rate limits.
OPENROUTER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# SECURE ALERTS & INTEGRATIONS (Optional / Recommended)
# ==========================================
# Hostinger Custom Domain SMTP credentials:
HOSTINGER_SMTP_HOST="smtp.hostinger.com"
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_USER="info@aaditechs.in"
HOSTINGER_SMTP_PASS=""
HOSTINGER_NOTIFICATION_EMAIL="shaikhaziz267@hotmail.com"

# Telegram Bot API credentials:
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID="9619655391"
